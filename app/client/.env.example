# Admin Dashboard Environment Variables
# Copy this file to .env.local and fill in values
# In dev, Vite proxy handles /api → localhost:5000 so VITE_API_URL is optional locally
# NEVER commit .env.local to Git

# Production: your deployed backend URL
# VITE_API_URL=https://fitpulse-api.onrender.com/api

# Production: your deployed admin dashboard URL
# VITE_DASHBOARD_URL=https://fitpulse-app.vercel.app
